# ============================================================
#  نمونهٔ تنظیمات محیطی — این فایل را کپی کن و مقدارها را پر کن
#
#      cp .env.example .env
#
#  ⚠️  فایل .env هرگز نباید در گیت کامیت شود (در .gitignore هست).
#  ⚠️  این فایل فقط اسکلت است و هیچ رمز واقعی ندارد.
# ============================================================

# ---------- Django ----------
# اجرای کلید جدید:
#     python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# '1' فقط برای توسعه. در تولید همیشه '0'
DJANGO_DEBUG=0

# '1' اگر سایت پشت TLS/HTTPS است
DJANGO_USE_HTTPS=0

# دامنه‌ها/آی‌پی‌های مجاز، جدا شده با کاما
#   مثال: DJANGO_ALLOWED_HOSTS=attendance.example.com,192.168.1.10
#   برای تست محلی: 127.0.0.1,localhost,testserver
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------- Gunicorn ----------
# پورت ۸۰ یک پورت ممتاز است؛ اگر root اجرا نمی‌کنی از ۸۰۰۰ استفاده کن
#   و برای بیرون از شبکه محلی، پورت را با ufw باز کن
HOST=0.0.0.0
PORT=8000

# تعداد worker/thread — نکتهٔ معماری: وضعیت دوربین درون‌پروسه‌ای است،
# پس Workers باید 1 بماند و بار با Threads پوشش داده شود.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# مدل چهره گاهی در اولین درخواست کند است؛ اگر تایم‌اوت خوردی بالا ببر
GUNICORN_TIMEOUT=120

# ---------- اختیاری ----------
# فقط اگر CSRF را به دامنه‌های دیگر نیاز داری:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://attendance.example.com
#
# اگر از HTTPS استفاده می‌کنی، برای ماندگاری کوکی پشت پروکسی:
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO